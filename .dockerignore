# Without this file every build ships the whole directory to the daemon,
# including both virtualenvs (.venv and flink/.venv-flink — the latter holds a
# full Flink distribution). That is slow on every build and, worse, any COPY of
# a directory containing a venv bakes host-built binaries into the image.
.venv/
flink/.venv-flink/
**/__pycache__/
*.pyc

.git/
.gitignore

# Secrets never belong in an image layer. Compose passes these in at runtime
# via env_file/environment instead.
.env
.env.*

# Local state and build output
logs/
dbt/target/
dbt/dbt_packages/
*.duckdb
.DS_Store
**/.DS_Store

# The training set is only needed to retrain, not to score. The serialised
# model in ml/models/ is what the consumer loads at startup.
ml/data/
